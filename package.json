{
  "name": "agent-guard",
  "version": "0.1.0",
  "description": "Resilient, zero-telemetry local MCP server, keep-awake supervisor, and Antigravity Stop hook for reliable autonomous pairing.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-guard": "./dist/cli.js",
    "agent-guard-server": "./dist/index.js",
    "agent-guard-stop": "./dist/hook/stop-hook.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "install:antigravity": "node dist/cli.js install",
    "update": "node dist/cli.js update",
    "doctor": "node dist/cli.js doctor",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "antigravity",
    "agent-guard",
    "keep-awake",
    "caffeinate",
    "ledger",
    "ai-agents",
    "autonomous-coding",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "templates",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "author": {
    "name": "Sarvesh",
    "url": "https://github.com/anksarvesh-lgtm"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anksarvesh-lgtm/agent-guard.git"
  },
  "homepage": "https://github.com/anksarvesh-lgtm/agent-guard#readme",
  "bugs": {
    "url": "https://github.com/anksarvesh-lgtm/agent-guard/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
