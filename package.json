{
  "name": "agent-guard",
  "version": "0.1.0",
  "description": "Resilient, zero-telemetry local MCP server, keep-awake supervisor, and Antigravity Stop hook for reliable autonomous pairing.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-guard": "./dist/cli.js",
    "agent-guard-server": "./dist/index.js",
    "agent-guard-stop": "./dist/hook/stop-hook.js"
  },
  "scripts": {
